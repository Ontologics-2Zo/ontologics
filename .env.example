# Copy to .env.local, then set your own key locally. Never commit the key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini-2026-03-17
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_OUTPUT_TOKENS=4096

# Explicit service request allowance. Leave both empty to disable paid calls.
# Set the cap to your team's approved amount; no default operating amount.
ONTOLOGICS_REQUEST_MAX_COST_USD=
ONTOLOGICS_MODEL_PRICES_JSON=
# Price shape example (verify current rates before use; cap is independent):
# {"gpt-5.4-mini-2026-03-17":{"input_usd_per_million":"0.75","output_usd_per_million":"4.50","max_input_tokens":400000},"text-embedding-3-small":{"input_usd_per_million":"0.02","output_usd_per_million":"0","max_input_tokens":300000}}
# This is not a personal evaluation allowance or an account-wide billing limit.

# Local PostgreSQL + pgvector. Replace the password in both fields.
POSTGRES_PASSWORD=replace-local-password
DATABASE_URL=postgresql://ontologics:replace-local-password@127.0.0.1:55432/ontologics
ONTOLOGICS_DB_SCHEMA=ontologics
