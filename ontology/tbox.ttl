@prefix o: <urn:ontologics:> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
o:Ontology a owl:Ontology ; owl:versionInfo "graph-0.5" .
o:SourceDocument a owl:Class .
o:Evidence a owl:Class .
o:ProductModel a owl:Class .
o:ProductRevision a owl:Class .
o:Configuration a owl:Class .
o:ComponentModel a owl:Class .
o:BOMItem a owl:Class .
o:ProductUnit a owl:Class .
o:ComponentLot a owl:Class .
o:Installation a owl:Class .
o:HistoryCoverage a owl:Class .
o:InventoryMovement a owl:Class .
o:Contract a owl:Class .
o:ContractItem a owl:Class .
o:DeliveryRound a owl:Class .
o:FulfillmentSnapshot a owl:Class .
o:FinishedGoodsStock a owl:Class .
o:ProductionWork a owl:Class .
o:ProductionObservation a owl:Class .
o:Allocation a owl:Class .
o:Shipment a owl:Class .
o:DeliveryCondition a owl:Class .
o:source_id a owl:ObjectProperty ; rdfs:range o:SourceDocument .
o:model_id a owl:ObjectProperty ; rdfs:range o:ProductModel .
o:revision_id a owl:ObjectProperty ; rdfs:range o:ProductRevision .
o:configuration_id a owl:ObjectProperty ; rdfs:range o:Configuration .
o:component_id a owl:ObjectProperty ; rdfs:range o:ComponentModel .
o:unit_id a owl:ObjectProperty ; rdfs:range o:ProductUnit .
o:lot_id a owl:ObjectProperty ; rdfs:range o:ComponentLot .
o:contract_id a owl:ObjectProperty ; rdfs:range o:Contract .
o:contract_item_id a owl:ObjectProperty ; rdfs:range o:ContractItem .
o:snapshot_id a owl:ObjectProperty ; rdfs:range o:FulfillmentSnapshot .
o:production_work_id a owl:ObjectProperty ; rdfs:range o:ProductionWork .
o:delivery_round_id a owl:ObjectProperty ; rdfs:range o:DeliveryRound .
o:stock_id a owl:ObjectProperty ; rdfs:range o:FinishedGoodsStock .
o:allocation_id a owl:ObjectProperty ; rdfs:range o:Allocation .
o:round_ids a owl:ObjectProperty ; rdfs:range o:DeliveryRound .
o:evidence a owl:ObjectProperty ; rdfs:range o:Evidence .
o:ProductModel owl:disjointWith o:ProductUnit, o:ComponentModel, o:ComponentLot .
o:ComponentModel owl:disjointWith o:ComponentLot .
# Required fields, identity, time and approvals are enforced by Python, not OWL inference.
